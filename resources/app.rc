#include "../src/ui/Resource.h"
#include "../src/common/version.h"

// 应用程序清单
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// 版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_COMMA
PRODUCTVERSION  VERSION_COMMA
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          0x40004L   // VOS_NT_WINDOWS32
FILETYPE        0x00000001L // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      ""
            VALUE "FileDescription",  "Ext4WslHelper - EXT4 SD Card Access Tool"
            VALUE "FileVersion",      VERSION_STRING
            VALUE "InternalName",     "Ext4WslHelper"
            VALUE "LegalCopyright",   ""
            VALUE "OriginalFilename", "Ext4WslHelper.exe"
            VALUE "ProductName",      "Ext4WslHelper"
            VALUE "ProductVersion",   VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
